# Copie este arquivo para ".env" e ajuste os valores antes de rodar o projeto.
# Nunca coloque segredos reais de produção neste arquivo de exemplo.

ENVIRONMENT=development
DEBUG=true

# Banco de dados (usado pelo docker-compose para criar o Postgres)
POSTGRES_USER=conecta
POSTGRES_PASSWORD=conecta
POSTGRES_DB=conecta_escola

# URL completa usada pela API (ajustada automaticamente no docker-compose;
# necessária apenas se rodar a API fora do Docker)
DATABASE_URL=postgresql+psycopg://conecta:conecta@localhost:5432/conecta_escola
REDIS_URL=redis://localhost:6379/0

# Segurança — GERE UM VALOR PRÓPRIO E SECRETO ANTES DE IR PARA PRODUÇÃO
SECRET_KEY=dev-secret-key-troque-isto
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Primeiro administrador técnico. Não existe cadastro público de usuários: na
# inicialização, se o e-mail ainda não existir, a conta é criada com esta senha
# (mínimo de 8 caracteres). Depois do primeiro login, estas duas linhas podem ser removidas.
BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.com
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-agora
